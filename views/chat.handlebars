<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teki Chat</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="chat_container">
        <div class="cnt_cht_erro hidden">
            <button class="cht_erro">
                <img src="/img/cht_erro.png" class="chat_img_erro">
            </button>
        </div>
        <div class="cht_erro_form hidden">
            <div class="cht_erro_form_cnt">
                <div class="cnt_cht_err_btn">
                    <button class="cht_err_btn">&#88;</button>
                </div>
                <div class="cht_inc">
                    <p class="cht_erro_form_titulo">Encontrou alguma coisa fora dos conformes?</p>
                    <p class="cht_erro_form_subtitle">Nos conte aqui!</p>
                    <select id="opcaoSelect">
                        <option value="nada"></option>
                        <option value="conceito1">Conceito</option>
                        <option value="tratamento">Tratamento</option>
                        <option value="prevencao">Prevenção</option>
                        <option value="publico-alvo">Público-Alvo</option>
                        <option value="Carrossel">Carrosel</option>
                        <option value="vídeo">Vídeo</option>
                    </select>
                    <select class="sortidosselect hidden" id="sortidosselect">
                    </select>
                    <label id="opcaoLabel" for="opcaoSelect">Comentário</label>
                    <textarea class="cht_erro_form_txt" placeholder="Digite aqui o que gostaria de corrigir"></textarea>
                    <button class="cht_erro_form_btn" disabled>Enviar</button> <!-- Botão inicialmente desabilitado -->
                </div>
            </div>
        </div>
        <div class="chat_cnt">
            <div class="centraliza_chat">
                <img src="/img/teki_responde_lupa_branca.png" class="pagchat_img">
            </div>
            <div class="chat_sep">
                <div class="chat_pesq">
                    <input type="text" placeholder="O que você quer descobrir hoje?" class="chat_plc" name="pesquisar" id="pesquisar" autocomplete="off">
                    <button type="button" id="searchButton"><img src="/img/lupa.png" class="pesquisar_img"></button>
                    <div id="suggestions"></div>
                </div>
            </div>
        
            
